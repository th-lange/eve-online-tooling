# Copy this file to `.env` to point `npm run tauri dev` at a Firebase project
# for the Feedback module. A build with these unset reports "not configured" and
# falls back to filing on GitHub (see docs/feedback.md).
#
# `.env` is git-ignored. A real environment variable overrides it, so CI — which
# injects these from repository secrets — is unaffected.
#
# Only these two keys are used; the Rust client speaks Firebase's REST API
# directly and needs nothing else from a Firebase web config.
EVE_TOOLING_FIREBASE_PROJECT_ID=your-project-id
EVE_TOOLING_FIREBASE_API_KEY=AIza...
